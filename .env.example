# --- Postgres (TimescaleDB) ---
DATABASE_URL=postgresql+asyncpg://use:use_dev@localhost:5432/use
POSTGRES_SYNC_URL=postgresql://use:use_dev@localhost:5432/use

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=use_dev_neo4j

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- NATS ---
NATS_URL=nats://localhost:4222

# --- MinIO ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=use
MINIO_SECRET_KEY=use_dev_minio
MINIO_SECURE=false
MINIO_RAW_BUCKET=use-raw

# --- Auth ---
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=30

# --- App ---
LOG_LEVEL=INFO
ENVIRONMENT=development
